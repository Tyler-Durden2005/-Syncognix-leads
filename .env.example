# Supabase — Project Settings → API (or Data API) in the Supabase dashboard.
# The anon key is safe to expose to the browser; access is enforced by Row Level Security.
# Never put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: public URL of the app, used in auth email links when the request
# origin can't be determined (e.g. behind some proxies). Example: https://app.example.com
NEXT_PUBLIC_SITE_URL=

# Optional: identity sent to OpenStreetMap services (Nominatim/Overpass).
# Defaults to "BlackWolves-Leads/0.1". OSM_CONTACT_EMAIL is appended so their
# operators can reach you about your traffic.
NOMINATIM_USER_AGENT=
OSM_CONTACT_EMAIL=
